{
  "schemaVersion": 1,
  "id": "mytestclient",
  "version": "${version}",
  "name": "VoidClient",
  "description": "A modular testing & utility client: click GUI, HUD editor, waypoints, overlays, profiles and more.",
  "authors": ["VoidClient contributors"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.mytestclient.MyTestClient"]
  },
  "mixins": ["mytestclient.mixins.json"],
  "custom": {
    "voidclient:label": "${label}"
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
